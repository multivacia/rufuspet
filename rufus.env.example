# Configuração do recebimento de pedidos (lida pelo api/pedido.php a cada pedido).
# No servidor: salve como "rufus.env" na pasta ACIMA do public_html (ex.: /home/usuario/rufus.env),
# para não ficar acessível pela web. Em desenvolvimento: "rufus.env" na raiz do projeto.

LOJA_NOME=Rufus
FUSO_HORARIO=America/Sao_Paulo

# Pasta onde cada pedido é gravado como TXT. Padrão: rufus-pedidos/ ao lado do public_html.
# PEDIDOS_PASTA=/home/usuario/rufus-pedidos

# E-mail (desligado por enquanto). Para ligar: PEDIDOS_ENVIAR_EMAIL=true.
# Na HostGator, use como remetente uma conta do seu domínio (ex.: pedidos@seudominio.com.br)
# para o e-mail não cair no spam.
PEDIDOS_ENVIAR_EMAIL=false
PEDIDOS_EMAIL_DESTINO=seu-email@exemplo.com
PEDIDOS_EMAIL_REMETENTE=pedidos@seudominio.com.br
PEDIDOS_COPIA_CLIENTE=false
