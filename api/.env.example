DATABASE_URL=postgres://rufus:SENHA@localhost:5432/rufus
JWT_SECRET=
PORT=3000
NODE_ENV=production
FUSO_HORARIO=America/Sao_Paulo
LOJA_NOME=Rufus

# Cada pedido é gravado como TXT nesta pasta (fora da pasta pública do site).
PEDIDOS_PASTA=/var/lib/rufus/pedidos
# Máximo de pedidos por hora por IP.
PEDIDOS_LIMITE_POR_HORA=10

# E-mail: enquanto SMTP_HOST estiver vazio, nenhum e-mail é enviado (só o TXT é gravado)
# e as notificações ficam "pendente" na tabela notificacoes.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=sua conta, SMTP_PASS=senha de app
# (myaccount.google.com/apppasswords, exige verificação em duas etapas) e EMAIL_REMETENTE com a mesma conta,
# ex.: EMAIL_REMETENTE="Rufus Pedidos <sua-conta@gmail.com>". Mudou o .env? Reinicie a API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE=
# Quem recebe cada pedido (separe por vírgula).
EMAILS_INTERNOS=voce@exemplo.com

# WhatsApp (Twilio): envio ainda não implementado; se WHATSAPP_GRUPO estiver preenchido,
# a notificação é registrada como pendente.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_GRUPO=

EMAIL_CONTINGENCIA=
WHATSAPP_CONTINGENCIA=
