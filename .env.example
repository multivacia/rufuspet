# Copie para .env.local (desenvolvimento) ou cadastre no painel da hospedagem (produção).
# Alterações exigem reiniciar o servidor / novo deploy.

# --- Dados exibidos no site (rodapé, título) ---
LOJA_NOME=Rufus
LOJA_RAZAO_SOCIAL=Rufus Distribuidora Ltda (exemplo)
LOJA_CNPJ=00.000.000/0001-00
LOJA_TELEFONE=(11) 0000-0000
LOJA_WHATSAPP=(11) 90000-0000
LOJA_EMAIL_CONTATO=contato@exemplo.com.br
LOJA_ENDERECO=São Paulo/SP
LOJA_HORARIO_ATENDIMENTO=Seg. a sex., 8h às 18h
LOJA_INSTAGRAM=@rufuspet

# --- Pedidos ---
# Caixa que recebe cada pedido enviado pelo site.
PEDIDOS_EMAIL_DESTINO=seu-email@exemplo.com
# Envia cópia de confirmação ao cliente (true/false).
PEDIDOS_COPIA_CLIENTE=true

# --- SMTP (envio dos e-mails) ---
# Gmail: host smtp.gmail.com, porta 465, usuário = seu Gmail,
# senha = "senha de app" (myaccount.google.com/apppasswords; exige verificação em duas etapas).
# Sem SMTP em desenvolvimento, o e-mail aparece no terminal; em produção o envio falha com erro.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Rufus Pedidos <seu-email@exemplo.com>"
